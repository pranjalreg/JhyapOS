# ---------------------------------------------------------------------------
# Waitlist storage
#
# Copy to `.env.local` (gitignored) and fill in. Never commit real values, and
# never prefix any of these with NEXT_PUBLIC_ — that would ship them to the
# browser. Everything here is read on the server only.
# ---------------------------------------------------------------------------

# One of: postgres | file | memory
# Defaults to `file` in development and `memory` otherwise.
#
# IMPORTANT: `memory` does not persist. In production the API refuses signups
# outright rather than accepting them and losing them, so a real deployment
# must set this to `postgres`.
WAITLIST_STORE=file

# Used when WAITLIST_STORE=file
WAITLIST_FILE=.data/waitlist.jsonl

# Used when WAITLIST_STORE=postgres.
# The table is created automatically on first request.
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Set to `false` only for a local Postgres with no TLS. Managed providers
# (Vercel, Neon, Supabase, RDS) need the default.
# DATABASE_SSL=true
