# ---------------------------------------------------------------------------
# Waitlist storage
#
# Copy to `.env.local` (gitignored) and fill in. Never commit real values, and
# never prefix any of these with NEXT_PUBLIC_ — that would ship them to the
# browser. Everything here is read on the server only.
# ---------------------------------------------------------------------------

# One of: postgres | file | memory
# Defaults to `file` in development and `memory` otherwise.
WAITLIST_STORE=file

# Used when WAITLIST_STORE=file
WAITLIST_FILE=.data/waitlist.jsonl

# Used when WAITLIST_STORE=postgres — also run: npm install pg @types/pg
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_SSL=true
